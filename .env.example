# GharSetu environment variables. Copy to `.env` for local dev.
# Every value here is consumed in src/config.ts.

# --- core ------------------------------------------------------------------
NODE_ENV=development                                  # development | production
PORT=8080                                             # HTTP port the server binds to
HOST=0.0.0.0                                          # bind address (use 127.0.0.1 to restrict to local)
LOG_LEVEL=debug                                       # pino level: trace|debug|info|warn|error|fatal

# --- storage ---------------------------------------------------------------
DB_PATH=/tmp/gharsetu.db                              # SQLite file (ephemeral on Cloud Run /tmp)
UPLOADS_DIR=/tmp/uploads                              # listing image directory
SEED_ON_START=1                                       # 1 = seed demo users + listings if DB is empty

# --- auth ------------------------------------------------------------------
JWT_SECRET=replace_with_64_hex_chars_min_32_chars     # HS256 signing key; >=32 chars required
COOKIE_SECRET=replace_with_64_hex_chars_min_32_chars  # @fastify/cookie signing secret (defaults to JWT_SECRET)
COOKIE_SECURE=0                                       # 1 in prod (HTTPS), 0 for local http://
ADMIN_EMAIL=admin@gharsetu.local                      # bootstrap super-admin email (created on seed)
ADMIN_PASSWORD=Admin@2026                             # bootstrap super-admin password (rotate after deploy)

# --- ONDC (Beckn) simulation ----------------------------------------------
ONDC_BAP_URI=https://gharsetu.local/ondc/v1           # Buyer App URI (we publish this in context.bap_uri)
ONDC_BAP_ID=gharsetu.local                            # Buyer App identifier
ONDC_BPP_URI=https://gharsetu.local/ondc/v1           # Seller App URI
ONDC_BPP_ID=gharsetu.local                            # Seller App identifier
ONDC_DOMAIN=ONDC:RET11                                # Beckn domain (RET11 = local services)
ONDC_COUNTRY=IND                                      # ISO country code
ONDC_CITY=std:0792                                    # STD code (0792 = Solan)

# --- Razorpay (simulated) --------------------------------------------------
RZP_KEY_ID=rzp_test_simulated                         # Razorpay key id (test mode)
RZP_KEY_SECRET=simulated_secret_aaaaaaaaaaaaaa        # Razorpay key secret
RZP_WEBHOOK_SECRET=simulated_webhook_secret           # HMAC secret used to verify /pay/webhook

# --- DigiLocker (simulated) ------------------------------------------------
DIGILOCKER_CLIENT_ID=simulated_dl_client              # OAuth2 client id
DIGILOCKER_CLIENT_SECRET=simulated_dl_secret          # OAuth2 client secret
DIGILOCKER_REDIRECT_URI=http://localhost:8080/verify/digilocker/callback  # OAuth2 redirect (must match registered URI)
DIGILOCKER_AUTH_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize  # auth endpoint
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token     # token endpoint

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_MAX=200                                    # max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000                            # window size in ms

# --- localization ----------------------------------------------------------
DEFAULT_CITY=Solan                                    # used when geo/IP detection fails
DEFAULT_LANG=en                                       # en | hi
