{
  "name": "gharsetu",
  "version": "0.1.0",
  "description": "Localized PG/room rental for university students. ONDC-connected. Cloud Run deployable.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "python3 scripts/render_pages.py && tsc -p tsconfig.json && cp -r src/views dist/views && cp -r src/locales dist/locales && cp -r src/public dist/public && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --test tests/smoke.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format:check": "echo 'no formatter configured' && exit 0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/view": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.7.0",
    "ejs": "^3.1.10",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "sharp": "^0.34.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
