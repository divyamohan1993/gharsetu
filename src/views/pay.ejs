<%
  var fmt = new Intl.NumberFormat(lang === 'hi' ? 'hi-IN' : 'en-IN');
%>
<%- include('partials/head', { page: page, lang: lang, t: t }) %>
<body class="page-pay">
  <%- include('partials/header', { user: user, t: t, lang: lang, csrf: csrf, path: path }) %>
  <main id="main" tabindex="-1">
    <%- include('partials/flash', { flash: flash }) %>
    <div class="container narrow">
      <h1 class="page-head__title"><%= t('pay.h.title') %></h1>

      <section class="card">
        <h2><%= listing.title %></h2>
        <p class="muted"><%= listing.address_line %>, <%= listing.city %></p>
        <dl class="kv">
          <dt>Amount</dt>
          <dd><strong>₹<%= fmt.format(amount) %></strong></dd>
          <dt>For month</dt>
          <dd><%= for_month %></dd>
          <dt>Booking</dt>
          <dd><%= booking.id %></dd>
        </dl>
      </section>

      <section class="card">
        <h2><%= t('pay.amount', { amount: fmt.format(amount) }) %></h2>
        <p class="muted small">Powered by Razorpay (simulated for demo).</p>

        <button id="pay-btn" type="button" class="btn btn--primary btn--lg btn--block" data-booking="<%= booking.id %>" data-amount="<%= amount %>"><%= t('pay.btn.pay') %></button>

        <p id="pay-status" class="pay-status" role="status" aria-live="polite"></p>

        <noscript>
          <p class="muted">JavaScript is required for the payment simulator.</p>
        </noscript>
      </section>

      <p><a href="/student/dashboard" class="btn btn--ghost"><%= t('common.back') %></a></p>
    </div>

    <input type="hidden" id="pay-csrf" value="<%= csrf %>">
    <!--
      REAL Razorpay Checkout would look like this:

      <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
      <script>
        var rzp = new Razorpay({
          key: 'rzp_live_xxx',
          amount: amount_in_paise,
          currency: 'INR',
          name: 'GharSetu',
          description: 'Rent for {listing.title}',
          order_id: rzp_order_id,
          prefill: { email: user.email, contact: user.phone },
          handler: function(resp){ /* POST resp to /pay/webhook */ },
          theme: { color: '#E26A2C' }
        });
        document.getElementById('pay-btn').onclick = function(){ rzp.open(); };
      </script>
    -->
  </main>
  <%- include('partials/footer', { t: t }) %>
  <%- include('partials/scripts') %>
</body>
</html>
