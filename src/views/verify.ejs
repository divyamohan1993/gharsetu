<%- include('partials/head', { page: page, lang: lang, t: t }) %>
<body class="page-verify">
  <%- include('partials/header', { user: user, t: t, lang: lang, csrf: csrf, path: path }) %>
  <main id="main" tabindex="-1">
    <%- include('partials/flash', { flash: flash }) %>
    <div class="container narrow">
      <h1 class="page-head__title"><%= t('verify.h.title') %></h1>

      <% if (user && user.kyc_verified) { %>
        <div class="flash flash--ok" role="status"><%= t('verify.success') %></div>
        <p class="muted">Method: <%= user.kyc_method || 'digilocker' %></p>
      <% } else { %>
        <section class="card">
          <p><%= t('verify.intro') %></p>
          <ul class="checklist">
            <li>Issued by Government of India</li>
            <li>Aadhaar / driving licence / PAN supported</li>
            <li>We never store your raw documents</li>
          </ul>
          <form method="post" action="/verify/digilocker/init" class="form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button type="submit" class="btn btn--primary btn--lg"><%= t('verify.btn.start') %></button>
          </form>
        </section>
      <% } %>

      <p><a href="/" class="btn btn--ghost"><%= t('common.back') %></a></p>
    </div>
  </main>
  <%- include('partials/footer', { t: t }) %>
  <%- include('partials/scripts') %>
</body>
</html>
