<p style="text-align:left"><span style="font-size:16.0px;color:#E6E6E6">const </span><span style="font-size:16.0px;color:#F5C46B">expected</span><span style="font-size:16.0px;color:#E6E6E6"> = createHmac(</span><span style="font-size:16.0px;color:#9DD8A2">&quot;sha256&quot;</span><span style="font-size:16.0px;color:#E6E6E6">,</span></p>
<p style="text-align:left"><span style="font-size:16.0px;color:#E6E6E6">    config.RZP.WEBHOOK_SECRET)</span></p>
<p style="text-align:left"><span style="font-size:16.0px;color:#E6E6E6">  .update(rawBody)</span></p>
