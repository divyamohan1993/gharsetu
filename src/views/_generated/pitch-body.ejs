<p style="text-align:left"><span style="font-size:16.0px;color:#E6E6E6">if (!timingSafeEqual(</span></p>
<p style="text-align:left"><span style="font-size:16.0px;color:#E6E6E6">       Buffer.from(expected),</span></p>
<p style="text-align:left"><span style="font-size:16.0px;color:#E6E6E6">       Buffer.from(req.headers[&quot;x-razorpay-signature&quot;])))</span></p>
<p style="text-align:left"><span style="font-size:16.0px;color:#E6E6E6">  return reply.code(</span><span style="font-size:16.0px;color:#F5C46B">400</span><span style="font-size:16.0px;color:#E6E6E6">).send();</span></p>
<p style="text-align:left"><span style="font-size:16.0px;color:#E6E6E6">// captured  --&gt;  insert renter_record (source=platform_payment)</span></p></div>
